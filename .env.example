# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit real values.

# --- Phase 1: Supabase (needed to start) -------------------------------------
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # "anon" or "publishable" key: goes into the app, protected by RLS
SUPABASE_PROJECT_REF=         # the <project-ref> part of the URL, used by the Supabase CLI

# Supabase dashboard > Project Settings > Database (used by migrations, never by the app)
SUPABASE_DB_PASSWORD=

# Read-only Postgres user for Power BI (created by a migration, password chosen by you)
POWERBI_DB_PASSWORD=

# --- Phase 2: CSV export to SharePoint (not needed yet) -----------------------
# Stored as Supabase Edge Function secrets (`supabase secrets set`), never in the app.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
# SHAREPOINT_FOLDER=PerfFoot/export
